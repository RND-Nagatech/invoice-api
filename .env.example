PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/invoicekilat
REDIS_HOST=localhost
REDIS_PORT=6379
# OTP validity in minutes (integer 1-60)
PASSWORD_RESET_OTP_TTL_MINUTES=5
# Lifetime successful voice drafts for each Free business (0 disables the trial).
AI_FREE_VOICE_TRIAL_LIMIT=3
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Password reset OTP email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=InvoiceKilat <no-reply@your-verified-domain.com>
# Local testing before a custom domain is verified:
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_TEST_RECIPIENT=the-email-allowed-by-your-resend-account
# Leave RESEND_TEST_RECIPIENT empty in production.
RESEND_TEST_RECIPIENT=
# Public/tunnel hostname reachable by customers; leave /view off this base.
PUBLIC_INVOICE_BASE_URL=http://localhost:3000/api/v1/public/invoices
PAYMENT_WEBHOOK_SECRET=replace-with-a-payment-webhook-secret
SINGAPAY_ENABLED=false
SINGAPAY_ENVIRONMENT=sandbox
SINGAPAY_AUTH_VERSION=1.1
SINGAPAY_CLIENT_ID=
SINGAPAY_CLIENT_SECRET=
SINGAPAY_API_KEY=
SINGAPAY_ACCOUNT_ID=
SINGAPAY_HMAC_KEY=
SINGAPAY_TIMEOUT_MS=30000
SINGAPAY_WEBHOOK_PATH=/api/v1/payments/webhook/singapay

# Subscription demo never displays a payable QRIS. Pro lasts one calendar month.
SUBSCRIPTION_PAYMENT_MODE=demo
SUBSCRIPTION_PRO_PRICE=129000
BILLING_REVIEW_EMAIL=
# Generate a unique password of at least 16 characters.
BILLING_ADMIN_PASSWORD=
# Use a public/tunnel URL to review on a different device.
BILLING_PUBLIC_BASE_URL=http://localhost:3000/api/v1/subscriptions
